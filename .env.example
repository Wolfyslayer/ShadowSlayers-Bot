# Trusted API service (never run this service on the bot host)
PORT=3000
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Public backend origin used by the static dashboard build. This is not a secret.
VITE_API_BASE_URL=""
VITE_BASE_PATH="/"

# Discord Bot & OAuth2 (Trusted Server Runtime Only - NEVER expose to frontend)
DISCORD_BOT_TOKEN=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_GUILD_ID=""
DISCORD_COMMAND_SCOPE="auto"

# Admin Authentication (Server-side verification only)
# Leave empty in first-run preview to claim via inline setup form, or set a strong passcode
ADMIN_PASSCODE=""
ADMIN_DISCORD_USER_IDS=""
ALLOWED_ORIGINS=""
SESSION_SECRET=""

# Database Selection: "local" for development, "firestore" for production
DATABASE_ADAPTER="local"
LOCAL_DB_PATH=".data/shadowslayers-db.json"

# Firebase Admin SDK (trusted bot/API server-side only; never commit real credentials)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
