{
  "name": "shadowslayers-bot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:bot": "tsx apps/bot/src/main.ts",
    "build:bot": "esbuild apps/bot/src/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-bot/index.js",
    "start:bot": "node dist-bot/index.js",
    "dev:dashboard": "vite",
    "build:dashboard": "vite build",
    "preview:dashboard": "vite preview",
    "dev:api": "tsx server.ts",
    "build:api": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-api/index.js",
    "start:api": "node dist-api/index.js",
    "check:bot-startup": "node scripts/check-bot-startup.cjs",
    "test": "tsx --test tests/*.test.ts",
    "clean": "node scripts/clean.cjs",
    "lint": "tsc --noEmit",
    "security:check": "node scripts/security-check.cjs"
  },
  "dependencies": {
    "discord.js": "^14.28.1",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "firebase-admin": "^14.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
